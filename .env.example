# Copy to .env — never commit secrets
# Markets + books always use https://clob.polymarket.com (public, no key)
PMXT_WALLET_ADDRESS=
# Live orders: Polygon private key for the signer (not the paper budget)
POLY_PRIVATE_KEY=
# Optional pre-derived CLOB L2 creds; otherwise derived from POLY_PRIVATE_KEY
CLOB_API_KEY=
CLOB_SECRET=
CLOB_PASS_PHRASE=
# 0=EOA  1=email/magic proxy (default when wallet set)  2=browser Gnosis Safe
POLY_SIGNATURE_TYPE=
POLYGON_RPC_URL=https://polygon-bor.publicnode.com

# paper (default) | live — TRADING_MODE=live or LIVE_TRADING=true
TRADING_MODE=paper
LIVE_TRADING=false
# false → live CLOB catalog/books; true → synthetic books
MOCK_MARKETS=false

# Infra
REDIS_URL=redis://localhost:6379/0
API_HOST=0.0.0.0
API_PORT=3847
NEXT_PUBLIC_API_URL=http://localhost:3847

# Ops
KILL_SWITCH=false
CITY_ROLES=paper,strict,metar
# Default operating budget (dashboard can override; persisted in ledger)
BUDGET_USD=500
LOG_LEVEL=INFO
