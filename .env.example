# Copy to .env — never commit secrets
# PMXT hosted API — https://www.pmxt.dev/docs/introduction
PMXT_API_KEY=
PMXT_WALLET_ADDRESS=

# paper (default) | live — live also requires LIVE_TRADING=true
TRADING_MODE=paper
LIVE_TRADING=false
MOCK_MARKETS=true

# Infra
REDIS_URL=redis://localhost:6379/0
API_HOST=0.0.0.0
API_PORT=3847
NEXT_PUBLIC_API_URL=http://localhost:3847

# Ops
KILL_SWITCH=false
CITY_ROLES=paper,strict,metar
LOG_LEVEL=INFO
