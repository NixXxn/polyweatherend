# WeatherBuyEnd Live — Polymarket CLOB (taker BUY NO)
# Copy to .env in Coolify / locally. NEVER commit .env.

# --- Polymarket CLOB (required for live) ---
POLY_PRIVATE_KEY=
POLY_API_KEY=
POLY_API_SECRET=
POLY_API_PASSPHRASE=
# 0 = EOA, 1 = Magic/email, 2 = Gnosis Safe / browser wallet proxy,
# 3 = deposit wallet / POLY_1271 (current Polymarket.com accounts)
POLY_SIGNATURE_TYPE=3
POLY_FUNDER=
POLY_CLOB_HOST=https://clob.polymarket.com
POLY_CHAIN_ID=137
POLY_GAMMA_URL=https://gamma-api.polymarket.com

# --- Mode (live-ready defaults; Arm in UI before trading) ---
TRADING_MODE=live
LIVE_TRADING=true
MOCK_MARKETS=false
KILL_SWITCH=true

# --- Ops ---
BUDGET_USD=500
CITY_ROLES=paper,strict,metar
REDIS_URL=redis://localhost:6379/0
API_HOST=0.0.0.0
API_PORT=3847
# Leave empty for Coolify same-origin /
NEXT_PUBLIC_API_URL=
LOG_LEVEL=INFO
